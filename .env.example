# Supabase Configuration
# Replace these values with your actual project credentials from the Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Portal Session Signing
# Secret used to sign (HMAC-SHA256) the examly_admin_session cookie. REQUIRED for admin login.
# Must be at least 32 random characters. If missing or too short, admin login and all /admin
# access are rejected (fail closed). Rotating it logs out every admin.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Left blank on purpose so a copied example never ships a known secret.
ADMIN_SESSION_SECRET=

# Admin Login Rate Limiting (Upstash Redis): https://console.upstash.com/ -> Redis -> your database -> REST API
# Durable, shared store for rate limits: admin login (5 failed attempts per IP+email per 15 min) and the
# exam join/transcribe/evaluate, AI generation and contact-form endpoints.
# Set BOTH in production. If either is missing, a per-instance in-memory limiter is used instead
# (resets on restart) and a warning is logged at startup.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI / Speech Services
# Deepgram: https://console.deepgram.com/ — used for audio transcription during exams
DEEPGRAM_API_KEY=your-deepgram-api-key

# Gemini: https://aistudio.google.com/apikey — used for AI-powered exam evaluation & insights
GEMINI_API_KEY=your-gemini-api-key
# Optional: Gemini model IDs (pinned stable models; verified against Google's model list
# https://aistudio.google.com/docs/models on 2026-11-26). Leave blank for the defaults.
# Default primary: gemini-3.6-flash   Default fallback: gemini-3.5-flash-lite
GEMINI_MODEL_PRIMARY=
GEMINI_MODEL_FALLBACK=

# Domain & Search Console Verification
NEXT_PUBLIC_APP_URL=https://examly.site
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code

# Recording retention (app/api/cron/recording-retention, scheduled daily in vercel.json)
# CRON_SECRET: Vercel sends it as "Authorization: Bearer <CRON_SECRET>" on cron calls. REQUIRED
# (min 16 chars); without it the cron endpoint rejects every request.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
# Dry run (log counts only, delete nothing) unless set to exactly "false".
RECORDING_RETENTION_DRY_RUN=true
