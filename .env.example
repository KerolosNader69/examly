# Supabase Configuration
# Replace these values with your actual project credentials from the Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI / Speech Services
# Deepgram: https://console.deepgram.com/ — used for audio transcription during exams
DEEPGRAM_API_KEY=your-deepgram-api-key

# Gemini: https://aistudio.google.com/apikey — used for AI-powered exam evaluation & insights
GEMINI_API_KEY=your-gemini-api-key
